# Copy this to .env and fill in your real values

PORT=3000
SESSION_SECRET=change_me_to_a_long_random_string

# Google OAuth — get these from https://console.cloud.google.com
# 1. Create a project → APIs & Services → Credentials
# 2. Create OAuth Client ID → Web Application
# 3. Add authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
